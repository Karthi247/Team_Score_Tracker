# Copy this file to .env and replace each placeholder before running Docker Compose.
MYSQL_ROOT_PASSWORD=replace-with-a-strong-mysql-root-password
MYSQL_USER=scoretracker
MYSQL_PASSWORD=replace-with-a-strong-application-password
APP_JWT_SECRET=replace-with-a-random-secret-at-least-32-characters-long
APP_JWT_EXPIRATION_MS=86400000
